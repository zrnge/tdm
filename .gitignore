# ---- dependencies & build output (regenerated by npm install / npm run build) ----
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
coverage/

# ---- secrets & local config: never commit ----
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.p12
*.pfx
secrets/
credentials*.json

# ---- logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- editors, OS, tooling ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
.claude/

# ---- scratch ----
tmp/
temp/
*.tmp
